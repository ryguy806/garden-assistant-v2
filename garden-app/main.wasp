app Garden_Assistant {
  wasp: {
    version: "^0.20.0"
  },
  title: "BumbleBot Garden App",
  head: [
    "<link rel=\"shortcut icon\" href=\"/favicon.ico\" />"
  ],
  client: {
    rootComponent: import Layout from "@src/Layout/Layout.tsx",
  },
  server: {
    envValidationSchema: import { envValidationSchema } from "@src/env.ts",
  },
  auth: {
    userEntity: User,
    methods: {
      usernameAndPassword: {},
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/"
  },
}


//Queries
query getPlantAPIData {
  fn: import {fetchAllPlants} from "@src/api/api",
}

query fetchAllPerenualPlants {
  fn: import {fetchAllPerenualPlants} from "@src/api/newApi",
}

query lookForSpecificPerenualPlantScientificName {
  fn: import {lookForSpecificPerenualPlantScientificName} from "@src/api/newApi"
}

query searchForPerenualPlants {
  fn: import { searchForPerenualPlants } from "@src/api/newApi"
}

query getAllPlants {
  fn: import {getAllPlants} from "@src/operations/queries/serverActions",
  entities: [PlantProfileItem]
}

query getPlantById {
  fn: import {getPlantById} from "@src/operations/queries/serverActions",
  entities: [PlantProfileItem]
}


query getAllPerenualPlants {
  fn: import {getAllPerenualPlants} from "@src/operations/queries/newServerActions",
  entities: [PerenualPlantProfileItem]
}

query getPerenualPlantById {
  fn: import {getPerenualPlantById} from "@src/operations/queries/newServerActions",
  entities: [PerenualPlantProfileItem]
}

query getImageItemById {
  fn: import {getImageItemById} from "@src/operations/queries/serverActions",
  entities: [ImageItem]
}

//Routes
// -- Admin routes
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import  Login  from "@src/Auth/Login"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import  Signup  from "@src/Auth/Signup"
}

// -- Main route
route RootRoute { path: "/", to: MainPage }
page MainPage {
  authRequired: true,
  component: import { MainPage } from "@src/MainPage"
}

// -- Plant routes
route YardRoute { path: "/garden", to: YardPage}
page YardPage {
  authRequired: true,
  component: import Yard from "@src/pages/Garden/Yard"
}

route PlantProfileRoute { path: "/garden/:plant", to: PlantProfilePage}
page PlantProfilePage {
  authRequired: true,
  component: import PlantProfile from "@src/pages/Garden/PlantProfile"
}

//Search routes
route PlantSearchRoute {path: "/search", to: PlantSearchPage}
page PlantSearchPage {
  authRequired: true,
  component: import PlantLookUp from "@src/pages/Search/PlantLookUp"
}

route PlantProfileFromSearchRoute { path: "/search/:plant", to: PlantProfileFromSearchPage }
page PlantProfileFromSearchPage {
  authRequired: true,
  component: import PlantProfileAPI from "@src/pages/Search/PlantProfileAPI"
}

// -- Calendar routes
route CalendarRoute { path: "/calendar", to: CalendarPage }
page CalendarPage {
  authRequired: true,
  component: import CalendarView  from "@src/pages/Calendar/CalendarView"
}

route CalendarNewEventRoute {path: "/calendar/new", to: CalendarNewEventPage}
page CalendarNewEventPage {
  authRequired: true,
  component: import CalendarNewEvent from "@src/pages/Calendar/CalendarNewEvent"
}

route CalendarDayViewRoute { path: "/calendar/:day", to: CalendarDayViewPage}
page CalendarDayViewPage {
  authRequired: true,
  component: import CalendarDayView from "@src/pages/Calendar/CalendarDayView"
}

route CalendarNewEventDayRoute {path: "/calendar/:day/new", to: CalendarNewEventDayPage}
page CalendarNewEventDayPage {
  authRequired: true,
  component: import CalendarNewDayEvent from "@src/pages/Calendar/CalendarNewEvent"
}

// -- Journal routes
route JournalRoute { path: "/journal", to: JournalPage }
page JournalPage {
  authRequired: true,
  component: import JournalView  from "@src/pages/Journal/JournalView"
}

// AUTO CRUD
crud JournalItems {
  entity: JournalItem,
  operations: {
    getAll: {},
    create: {
      overrideFn: import {createJournalItem} from "@src/operations/actions/journalActions",
    }
  }
}

crud CalendarItems {
  entity: CalendarItem,
  operations: {
    getAll: {},
    create: {
      overrideFn: import {createCalendarItem} from "@src/operations/actions/calendarActions",
    }
  }
}

crud PlantProfileItems {
  entity: PlantProfileItem,
  operations: {
    getAll: {},
    get: {},
    create: {
      overrideFn: import {createPlantProfileItem} from "@src/operations/actions/gardenActions",
    },
    update: {}
  }
}

crud PerenualPlantProfileItems {
  entity: PerenualPlantProfileItem,
  operations: {
    getAll: {},
    get: {},
    create: {
      overrideFn: import {createPerenualPlantProfileItem} from "@src/operations/actions/gardenActions",
    },
    update: {}
  }
}

crud PlantItems {
  entity: PlantItem,
  operations: {
    getAll: {},
    get: {},
    create: {
      overrideFn: import {createPlantItem} from "@src/operations/actions/gardenActions",
    },
    update: {}
  }
}

crud GardenMapItems {
  entity: GardenMap,
  operations: {
    getAll: {},
    create: {}
  }
}
