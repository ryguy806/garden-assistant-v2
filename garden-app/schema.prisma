datasource db {
  provider = "sqlite"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

model User {
  id  Int @id @default(autoincrement())
  journalItems JournalItem[]
  calendarItems CalendarItem[]
  gardenMaps GardenMap[]
  plantProfileItems PlantProfileItem[]
}

model JournalItem {
  id Int @id @default(autoincrement())
  date DateTime @default(now())
  entry String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
}

model CalendarItem {
  id Int @id @default(autoincrement())
  title String
  createdDate DateTime @default(now())
  eventDate DateTime
  details String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
}

model PlantProfileItem {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  userId Int
  createdDate DateTime @default(now())
  plantedDate DateTime
  imageURL String? 
  name String
  garden String //GardenMap? @relation(fields: [id], references: [id])
  type String?
  group String
  fertilizerNeeds String
  details String
  notes NoteItem[]
}

model GardenMap {
  id Int @id @default(autoincrement())
  name String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
  // plantProfileItems PlantProfileItem[]
}

model ImageItem {
  id        Int      @id @default(autoincrement())
  filename  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model NoteItem {
  id Int @id @default(autoincrement())
  date DateTime @default(now())
  entry String
  plantid Int
  plantProfile PlantProfileItem @relation(fields: [plantid], references: [id])
}