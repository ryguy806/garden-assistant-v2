datasource db {
  provider = "sqlite"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

model User {
  id  Int @id @default(autoincrement())
  journalItems JournalItem[]
  calendarItems CalendarItem[]
  gardenMaps GardenMap[]
  perenualPlantProfileItem PerenualPlantProfileItem[]
}

model JournalItem {
  id Int @id @default(autoincrement())
  date DateTime @default(now())
  entry String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
  plantProfile PerenualPlantProfileItem? @relation(fields: [plantProfileId], references: [id])
  plantProfileId Int?
}

model CalendarItem {
  id Int @id @default(autoincrement())
  title String
  createdDate DateTime @default(now())
  eventDate DateTime
  details String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
}

model PerenualPlantProfileItem {
  id Int @id @default(autoincrement())
  plant_id Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  createdDate DateTime @default(now())
  default_image String
  common_name String
  scientific_name String
  type String
  dimensions DimensionsItem[]
  cycle String
  watering String
  description String
  soil String
  sunlight String
  hardiness HardinessItem?
  pruning_months PruningMonthItem[]
  maintenance String
  attracts AttractItem[]
  pest_susceptibility PestItem[]
  growth_rate String
  flowering_season String
  journal_items JournalItem[]

  @@unique([userId, plant_id])
}

model HardinessItem {
  id Int @id @default(autoincrement())
  plantProfileId Int @unique
  plant_profile PerenualPlantProfileItem @relation(fields: [plantProfileId], references: [id])
  min Int
  max Int
}

model PruningMonthItem {
  id Int @id @default(autoincrement())
  plantProfileId Int
  plant_profile PerenualPlantProfileItem @relation(fields: [plantProfileId], references: [id])
  month String
}

model AttractItem {
  id Int @id @default(autoincrement())
  plantProfileId Int
  plant_profile PerenualPlantProfileItem @relation(fields: [plantProfileId], references: [id])
  species String
}

model PestItem {
  id Int @id @default(autoincrement())
  plantProfileId Int
  plant_profile PerenualPlantProfileItem @relation(fields: [plantProfileId], references: [id])
  species String
}

model DimensionsItem {
  id Int @id @default(autoincrement())
  plantProfileId Int
  plant_profile PerenualPlantProfileItem @relation(fields: [plantProfileId], references: [id])
  type String
  min_value Float
  max_value Float
  unit String
}
model GardenMap {
  id Int @id @default(autoincrement())
  name String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
}