datasource db {
  provider = "sqlite"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

model User {
  id  Int @id @default(autoincrement())
  journalItems JournalItem[]
  calendarItems CalendarItem[]
  gardenMaps GardenMap[]
  gardenProfileItems GardenProfileItem[]
  treeProfileItems TreeProfileItem[]
}

model JournalItem {
  id Int @id @default(autoincrement())
  date DateTime @default(now())
  entry String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
}

model CalendarItem {
  id Int @id @default(autoincrement())
  title String
  createdDate DateTime @default(now())
  eventDate DateTime
  details String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
}

model GardenProfileItem {
  id Int @id @default(autoincrement())
  name String
  createdDate DateTime @default(now())
  details String
  user User? @relation(fields: [userId], references: [id])
  garden GardenMap? @relation(fields: [id], references: [id])
  userId Int?
}

model GardenMap {
  id Int @id @default(autoincrement())
  name String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
  gardenProfileItems GardenProfileItem[]
}

model TreeProfileItem {
  id Int @id @default(autoincrement())
  name String
  createdDate DateTime @default(now())
  details String
  user User? @relation(fields: [userId], references: [id])
  userId Int?
}